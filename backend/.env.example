# AI-Powered Personal Finance Management - Environment Configuration
PROJECT_NAME="AI-Powered Personal Finance Management and Expense Prediction System"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite for local development:
DATABASE_URL="sqlite:///./finance.db"

